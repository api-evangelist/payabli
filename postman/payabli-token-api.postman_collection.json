                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"state\": \"<string,null>\",\n  \"permissions\": null\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",

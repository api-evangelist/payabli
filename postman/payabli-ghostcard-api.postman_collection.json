              "item": [
                {
                  "name": "Create ghost card",
                  "id": "ea88c59b-0a11-40c5-9000-41d52796e916",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"vendorId\": \"<long>\",\n  \"expenseLimit\": \"<double>\",\n  \"amount\": \"<double>\",\n  \"maxNumberOfUses\": \"<integer>\",\n  \"exactAmount\": \"<boolean>\",\n  \"expenseLimitPeriod\": \"<string>\",\n  \"billingCycle\": \"<string>\",\n  \"billingCycleDay\": \"<string>\",\n  \"dailyTransactionCount\": \"<integer>\",\n  \"dailyAmountLimit\": \"<double>\",\n  \"transactionAmountLimit\": \"<integer>\",\n  \"expirationDate\": \"<string>\",\n  \"mcc\": \"<string>\",\n  \"tcc\": \"<string>\",\n  \"misc1\": \"<string>\",\n  \"misc2\": \"<string>\"\n}",
                      "options": {

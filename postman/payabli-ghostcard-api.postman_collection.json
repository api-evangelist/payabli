                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/MoneyOutCard/GhostCard/:entry",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "MoneyOutCard",
                        "GhostCard",
                        ":entry"
                      ],
                      "variable": [
                        {
                          "id": "cc6fc3bc-8a6d-4225-839d-74ff8be7e401",
                          "key": "entry",
                          "value": "<string>",
                          "description": "(Required) The entity's entrypoint identifier. [Learn more](/developers/api-reference/api-overview#entrypoint-vs-entry)"
                        }
                      ]
                    },
                    "description": "Creates a ghost card, a multi-use virtual debit card issued to a vendor for recurring or discretionary spend.\n\nUnlike single-use virtual cards issued as part of a payout transaction, ghost cards aren't tied to a specific payout. They're issued directly to a vendor and can be reused up to a configurable number of times within the card's spending limits.\n\nOnly one ghost card can exist per vendor per paypoint. To issue a new card to the same vendor, cancel the existing card first."
                  },

                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"routingNumber\": \"<string>\",\n  \"accountNumber\": \"<string>\",\n  \"accountType\": \"<string>\",\n  \"country\": \"<string>\",\n  \"accountHolderType\": \"<string>\",\n  \"holderName\": \"<string>\"\n}",

        {
          "id": "b60ae218-db26-4f9c-9e03-06612a10d7f1",
          "name": "Create ghost card",
          "request": {
            "name": "Create ghost card",
            "description": {
              "content": "Creates a ghost card, a multi-use virtual debit card issued to a vendor for recurring or discretionary spend.\n\nUnlike single-use virtual cards issued as part of a payout transaction, ghost cards aren't tied to a specific payout. They're issued directly to a vendor and can be reused up to a configurable number of times within the card's spending limits.\n\nOnly one ghost card can exist per vendor per paypoint. To issue a new card to the same vendor, cancel the existing card first.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "MoneyOutCard",
                "GhostCard",
                ":entry"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entry",
                  "description": "(Required) The entity's entrypoint identifier. [Learn more](/developers/api-reference/api-overview#entrypoint-vs-entry)"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": \"<long>\",\n  \"expenseLimit\": \"<double>\",\n  \"amount\": \"<double>\",\n  \"maxNumberOfUses\": \"<integer>\",\n  \"exactAmount\": \"<boolean>\",\n  \"expenseLimitPeriod\": \"<string>\",\n  \"billingCycle\": \"<string>\",\n  \"billingCycleDay\": \"<string>\",\n  \"dailyTransactionCount\": \"<integer>\",\n  \"dailyAmountLimit\": \"<double>\",\n  \"transactionAmountLimit\": \"<integer>\",\n  \"expirationDate\": \"<string>\",\n  \"mcc\": \"<string>\",\n  \"tcc\": \"<string>\",\n  \"misc1\": \"<string>\",\n  \"misc2\": \"<string>\"\n}",

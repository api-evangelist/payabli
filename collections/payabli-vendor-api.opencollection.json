{
  "opencollection": "1.0.0",
  "info": {
    "name": "API reference Bill Vendor API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Vendor",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create vendor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.payabli.com/api/Vendor/single/:entry",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entry",
                "value": "",
                "type": "path",
                "description": "Entrypoint identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a vendor in an entrypoint."
        },
        {
          "info": {
            "name": "Get vendor",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.payabli.com/api/Vendor/:idVendor",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "idVendor",
                "value": "",
                "type": "path",
                "description": "Vendor ID."
              }
            ]
          },
          "docs": "Retrieves a vendor's details, including enrichment status and payment acceptance info when available."
        },
        {
          "info": {
            "name": "Update vendor",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api-sandbox.payabli.com/api/Vendor/:idVendor",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "idVendor",
                "value": "",
                "type": "path",
                "description": "Vendor ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a vendor's information. Send only the fields you need to update."
        },
        {
          "info": {
            "name": "Delete vendor",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api-sandbox.payabli.com/api/Vendor/:idVendor",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "idVendor",
                "value": "",
                "type": "path",
                "description": "Vendor ID."
              }
            ]
          },
          "docs": "Delete a vendor."
        },
        {
          "info": {
            "name": "Enrich vendor",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.payabli.com/api/Vendor/enrich/:entry",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entry",
                "value": "",
                "type": "path",
                "description": "Entrypoint identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Triggers AI-powered vendor enrichment for an existing vendor. Runs one or more enrichment stages (invoice scan, web search) based on the `scope` parameter. Can automatically apply extracted payment acceptance info and vendor contact information to the vendor record, or return raw results for manual review. Contact Payabli to enable this feature."
        },
        {
          "info": {
            "name": "Schedule outreach call",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.payabli.com/api/Vendor/enrich/schedule_call/:entry",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entry",
                "value": "",
                "type": "path",
                "description": "Entrypoint identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Schedules an AI outreach call to a vendor to collect their preferred payment method and contact email. This is the third enrichment stage. Calls are scheduled for the next business day at around 9 AM in the vendor's timezone, with retries on no-answer and a fallback payment method applied when retries are exhausted. This feature is opt-in at the org level. Contact your Payabli representative to enable it, provision a phone number, and discuss pricing."
        },
        {
          "info": {
            "name": "Get outreach call status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.payabli.com/api/Vendor/:idVendor/enrichment/call-status",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "idVendor",
                "value": "",
                "type": "path",
                "description": "ID of the vendor to read call status for."
              }
            ]
          },
          "docs": "Returns the latest AI outreach call activity for a vendor. The response is a composite object with a `state` discriminator (`none`, `scheduled`, `successful`, or `failed`); the block that matches the current state is populated. When the vendor has no call activity, `state` is `none` and the response returns HTTP 200."
        }
      ]
    }
  ],
  "bundled": true
}
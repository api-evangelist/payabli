        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create ghost card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.payabli.com/api/MoneyOutCard/GhostCard/:entry",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entry",
                "value": "",
                "type": "path",
                "description": "The entity's entrypoint identifier. [Learn more](/developers/api-reference/api-overview#entrypoint-vs-entry)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a ghost card, a multi-use virtual debit card issued to a vendor for recurring or discretionary spend.\n\nUnlike single-use virtual cards issued as part of a payout transaction, ghost cards aren't tied to a specific payout. They're issued directly to a vendor and can be reused up to a configurable number of times within the card's spending limits.\n\nOnly one ghost card can exist per vendor per paypoint. To issue a new card to the same vendor, cancel the existing card first."
        },
        {
          "info": {
            "name": "Update card status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api-sandbox.payabli.com/api/MoneyOutCard/card/:entry",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entry",
                "value": "",
                "type": "path",
                "description": "The entity's entrypoint identifier. [Learn more](/developers/api-reference/api-overview#entrypoint-vs-entry)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the status of a virtual card (including ghost cards) under a paypoint."
        }
      ]
    }
  ],
  "bundled": true

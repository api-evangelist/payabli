          "id": "3049c22e-7b08-40dd-8315-513267f8a9cf",
          "name": "Get an access token (server-side)",
          "request": {
            "name": "Get an access token (server-side)",
            "description": {
              "content": "Exchanges a client ID and client secret for a short-lived Bearer access token using the OAuth2 client-credentials flow. Designed for server-to-server use: the credentials and the returned token stay on your backend. Send the returned `access_token` in the `Authorization` header as `Bearer <access_token>` on subsequent API calls. See the [OAuth authentication guide](/developers/oauth-authentication) for the full flow.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "Token",
                "serverside"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"<string>\",\n  \"clientSecret\": \"<string>\",\n  \"state\": \"<string,null>\",\n  \"permissions\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ]\n}",
